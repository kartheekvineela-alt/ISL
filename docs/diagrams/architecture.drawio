        <mxCell id="webcam" value='&lt;b&gt;Webcam&lt;/b&gt;&lt;br&gt;&lt;font style="font-size: 10px"&gt;OpenCV, 30 FPS&lt;/font&gt;' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#2a7f8f;strokeColor=none;fontColor=#ffffff;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="160" height="64" as="geometry"/></mxCell>
